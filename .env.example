# ==============================================================
# CONFIGURAÇÃO GERAL DO BOT DISCORD (AEVIX BOT)
# ==============================================================
# Preencha estas variáveis no arquivo .env (local) ou na aba
# "Environment" do seu serviço no Render.com.

# Token do Bot do Discord (Discord Developer Portal -> Bot -> Reset Token)
DISCORD_TOKEN=seu_token_aqui

# ID da Aplicação / Bot (Discord Developer Portal -> General Information -> Application ID)
CLIENT_ID=seu_client_id_aqui

# ID do Servidor Principal (Discord -> Botão direito no ícone do servidor -> Copiar ID)
GUILD_ID=seu_guild_id_aqui

# Porta para o servidor HTTP integrado (necessário para Render Web Service + UptimeRobot)
PORT=3000

# ==============================================================
# SISTEMA DE LOGS E AUDITORIA (AEVIX KEYS)
# ==============================================================
# ID do canal onde os logs de auditoria e atividades serão enviados
LOG_CHANNEL_ID=1558873432769298522

# Segredo de autenticação HTTP para a rota POST /api/log (opcional)
AEVIX_LOG_SECRET=seu_segredo_de_api_aqui

# ==============================================================
# CANAL DE VOZ 24/7
# ==============================================================
# ID do canal de voz onde o bot permanecerá conectado 24/7
VOICE_CHANNEL_ID=seu_canal_de_voz_id_aqui

# ==============================================================
# SISTEMA DE CARGO AUTOMÁTICO POR TAG (PRIMARY GUILD)
# ==============================================================
# ID do cargo atribuído automaticamente a quem usa a tag do servidor no perfil
TAG_ROLE_ID=1555852510139383919

# ID do canal de logs exclusivo para adição/remoção do cargo por tag
TAG_LOG_CHANNEL_ID=1559996459603075212

# (Opcional) ID ou sigla da tag caso queira filtrar especificamente
SERVER_TAG_ID=

# ==============================================================
# SISTEMA COMPLETO DE TICKETS
# ==============================================================
# Ativar ou desativar o sistema de tickets (true/false)
TICKETS_ENABLED=true

# Canal onde o painel "Central de Atendimento" ficará fixado permanentemente
TICKET_PANEL_CHANNEL_ID=1433174225153298513

# Canal para envio dos logs de abertura/fechamento e anexos de transcripts HTML
# (Padrão: reutiliza o LOG_CHANNEL_ID ou pode ser um canal exclusivo da equipe)
TICKET_LOG_CHANNEL_ID=1558873432769298522

# IDs dos cargos da equipe que têm permissão para ver e responder todos os tickets
# (Separe múltiplos IDs por vírgula. Se vazio, o bot detecta cargos de moderador automaticamente)
TICKET_STAFF_ROLE_IDS=

# Categorias correspondentes a cada tipo de atendimento:
TICKET_CATEGORY_COMPRAS=1572982188096356445
TICKET_CATEGORY_SUPORTE=1572981922009841665
TICKET_CATEGORY_DENUNCIAS=1572982012195770510

# Categoria de Parcerias (Adicione o ID da categoria quando criá-la no Discord)
TICKET_CATEGORY_PARCERIAS=

# Notificar (mencionar) a equipe quando um ticket for aberto (true/false)
TICKET_PING_STAFF=false

# Enviar cópia do transcript no privado (DM) do autor ao fechar o ticket (true/false)
TICKET_DM_TRANSCRIPT=true

# Tempo de contagem regressiva em segundos antes de deletar o canal do ticket
TICKET_CLOSE_DELAY_SECONDS=5

# Cooldown em segundos para evitar que o mesmo usuário abra múltiplos tickets em sequência
TICKET_OPEN_COOLDOWN_SECONDS=10

# Canal onde o comando /anttigre publica o aviso público contra divulgação de apostas
ANTTIGRE_CHANNEL_ID=1559996459603075212
